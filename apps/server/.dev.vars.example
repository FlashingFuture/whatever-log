# 로컬 개발용 비밀 값. 이 파일을 복사해 `.dev.vars`를 만들고 값을 채운다(.dev.vars는 gitignore됨).
# `wrangler dev`가 이 값을 Worker의 env로 넣어 준다. 따옴표 없이 `키=값` 한 줄씩 쓴다.
# 운영에서는 이 파일이 아니라 `pnpm exec wrangler secret put GOOGLE_CLIENT_SECRET`으로 올린다.
GOOGLE_CLIENT_SECRET=
# 메일 시험(docs/mail-design.md): Resend에서 만든 API 키. 비워 두면 /mail/test가 "설정되지 않음"(503)으로 답한다.
RESEND_API_KEY=
# 보고서 메일의 수신 거부 링크 서명 비밀(아무 긴 무작위 문자열, 예: `openssl rand -base64 32`). 비워 두면 확인 메일을 보내지 않는다.
MAIL_LINK_SECRET=
# Resend 웹훅(반송·스팸 신고) 서명 비밀(`whsec_…`). 비워 두면 웹훅이 503으로 답한다.
RESEND_WEBHOOK_SECRET=
